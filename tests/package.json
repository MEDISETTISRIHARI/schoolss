{
  "name": "tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest --config ./unit/jest.config.js --passWithNoTests && jest --config ./integration/jest.config.js --passWithNoTests && jest --config ./e2e/jest.config.js --passWithNoTests",
    "test:e2e": "jest --config ./e2e/jest.config.js --passWithNoTests",
    "test:integration": "jest --config ./integration/jest.config.js --passWithNoTests",
    "test:unit": "jest --config ./unit/jest.config.js --passWithNoTests",
    "test:api": "npx playwright test --config=../../playwright.config.ts"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.3.3",
    "reflect-metadata": "^0.2.2"
  }
}
