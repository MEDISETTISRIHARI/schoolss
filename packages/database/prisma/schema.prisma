generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                 String              @id @default(cuid())
  publicId           String              @unique @default(uuid())
  name               String
  subdomain          String?             @unique
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  address            String?
  phone              String?
  email              String?
  website            String?
  subscriptionPlan   String?
  subscriptionStatus String?
  settings           String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  academicYears      AcademicYear[]
  attendances        Attendance[]
  auditLogs          AuditLog[]
  awards             Award[]
  backupRecords      BackupRecord[]
  certificates       Certificate[]
  classes            Class[]
  enrollments        Enrollment[]
  examinations       Examination[]
  files              File[]
  homeworks          Homework[]
  marks              Mark[]
  notifications      Notification[]
  results            Result[]
  sections           Section[]
  subjects           Subject[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  users              User[]

  @@index([subdomain])
  @@index([isActive])
}

model User {
  id                 String               @id @default(cuid())
  publicId           String               @unique @default(uuid())
  email              String               @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  profileImageUrl    String?
  role               String
  status             String           @default("ACTIVE")
  schoolId           String?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  auditLogs          AuditLog[]
  uploadedFiles      File[]
  notifications      Notification[]
  PasswordResetToken PasswordResetToken[]
  principal          Principal?
  refreshTokens      RefreshToken[]
  schoolAdmin        SchoolAdmin?
  student            Student?
  teacher            Teacher?
  school             School?              @relation(fields: [schoolId], references: [id])

  @@index([email])
  @@index([schoolId])
  @@index([role])
}

model Student {
  id               String        @id @default(cuid())
  publicId         String        @unique @default(uuid())
  userId           String        @unique
  admissionNumber  String        @unique
  dateOfBirth      DateTime
  gender           String
  bloodGroup       String?
  address          String?
  guardianName     String?
  guardianPhone    String?
  guardianEmail    String?
  guardianRelation String?
  enrollmentDate   DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  attendances      Attendance[]
  awards           Award[]
  certificates     Certificate[]
  enrollments      Enrollment[]
  marks            Mark[]
  results          Result[]
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([admissionNumber])
}

model Teacher {
  id               String              @id @default(cuid())
  publicId         String              @unique @default(uuid())
  userId           String              @unique
  employeeId       String              @unique
  dateOfBirth      DateTime
  gender           String
  bloodGroup       String?
  address          String?
  qualification    String?
  experience       Int?
  joiningDate      DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  attendances      Attendance[]
  examinations     Examination[]
  homeworks        Homework[]
  marks            Mark[]
  user             User                @relation(fields: [userId], references: [id])
  assignments      TeacherAssignment[]
  timetableEntries TimetableEntry[]

  @@index([userId])
  @@index([employeeId])
}

model Principal {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String?   @unique
  dateOfBirth     DateTime?
  gender          String?
  qualification   String?
  appointmentDate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model SchoolAdmin {
  id              String    @id @default(cuid())
  userId          String    @unique
  employeeId      String?   @unique
  dateOfBirth     DateTime?
  gender          String?
  designation     String?
  appointmentDate DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AcademicYear {
  id                 String              @id @default(cuid())
  publicId           String              @unique @default(uuid())
  schoolId           String
  name               String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean             @default(false)
  isCurrent          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  school             School              @relation(fields: [schoolId], references: [id])
  attendances        Attendance[]
  classes            Class[]
  enrollments        Enrollment[]
  examinations       Examination[]
  homeworks          Homework[]
  results            Result[]
  sections           Section[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Class {
  id                 String              @id @default(cuid())
  publicId           String              @unique @default(uuid())
  schoolId           String
  academicYearId     String
  name               String
  displayName        String?
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attendances        Attendance[]
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  enrollments        Enrollment[]
  examinations       Examination[]
  homeworks          Homework[]
  results            Result[]
  sections           Section[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId])
  @@index([academicYearId])
}

model Section {
  id                 String              @id @default(cuid())
  publicId           String              @unique @default(uuid())
  schoolId           String
  classId            String
  academicYearId     String
  name               String
  capacity           Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attendances        Attendance[]
  enrollments        Enrollment[]
  examinations       Examination[]
  homeworks          Homework[]
  results            Result[]
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  class              Class               @relation(fields: [classId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, classId, name, academicYearId])
  @@index([classId])
  @@index([schoolId])
}

model Subject {
  id                 String              @id @default(cuid())
  publicId           String              @unique @default(uuid())
  schoolId           String
  name               String
  code               String?
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  attendances        Attendance[]
  examinations       Examination[]
  homeworks          Homework[]
  marks              Mark[]
  school             School              @relation(fields: [schoolId], references: [id])
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]

  @@unique([schoolId, name])
  @@unique([schoolId, code])
  @@index([schoolId])
}

model Enrollment {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String
  classId        String
  sectionId      String?
  academicYearId String
  rollNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, sectionId, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([academicYearId])
}

model TeacherAssignment {
  id             String       @id @default(cuid())
  schoolId       String
  teacherId      String
  classId        String
  sectionId      String?
  subjectId      String
  academicYearId String
  isClassTeacher Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, sectionId, subjectId, academicYearId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([academicYearId])
}

model Attendance {
  id               String           @id @default(cuid())
  publicId         String           @unique @default(uuid())
  schoolId         String
  studentId        String
  classId          String
  sectionId        String?
  subjectId        String?
  teacherId        String
  academicYearId   String
  date             DateTime
  status           String
  remarks          String?
  isFinalized      Boolean          @default(false)
  correctedBy      String?
  correctionReason String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  class            Class            @relation(fields: [classId], references: [id])
  school           School           @relation(fields: [schoolId], references: [id])
  section          Section?         @relation(fields: [sectionId], references: [id])
  student          Student          @relation(fields: [studentId], references: [id])
  subject          Subject?         @relation(fields: [subjectId], references: [id])
  teacher          Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([studentId, classId, sectionId, subjectId, date, academicYearId])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([studentId])
  @@index([teacherId])
  @@index([date])
  @@index([academicYearId])
}

model Examination {
  id             String          @id @default(cuid())
  publicId       String          @unique @default(uuid())
  schoolId       String
  academicYearId String
  classId        String
  sectionId      String?
  subjectId      String
  teacherId      String?
  name           String
  type           String
  date           DateTime
  totalMarks     Int
  passingMarks   Int
  isPublished    Boolean         @default(false)
  isFinalized    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  class          Class           @relation(fields: [classId], references: [id])
  school         School          @relation(fields: [schoolId], references: [id])
  section        Section?        @relation(fields: [sectionId], references: [id])
  subject        Subject         @relation(fields: [subjectId], references: [id])
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  marks          Mark[]
  results        Result[]

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([academicYearId])
  @@index([teacherId])
}

model Mark {
  id            String      @id @default(cuid())
  publicId      String      @unique @default(uuid())
  schoolId      String
  examinationId String
  studentId     String
  subjectId     String
  teacherId     String
  marksObtained Decimal
  remarks       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  examination   Examination @relation(fields: [examinationId], references: [id])
  school        School      @relation(fields: [schoolId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  teacher       Teacher     @relation(fields: [teacherId], references: [id])

  @@unique([examinationId, studentId, subjectId])
  @@index([schoolId])
  @@index([studentId])
  @@index([subjectId])
  @@index([teacherId])
}

model Result {
  id             String       @id @default(cuid())
  publicId       String       @unique @default(uuid())
  schoolId       String
  studentId      String
  classId        String
  sectionId      String?
  academicYearId String
  examinationId  String?
  totalMarks     Decimal
  obtainedMarks  Decimal
  percentage     Decimal
  grade          String?
  gpa            Decimal?
  cgpa           Decimal?
  status         String @default("DRAFT")
  publishedAt    DateTime?
  publishedBy    String?
  finalizedAt    DateTime?
  finalizedBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  examination    Examination? @relation(fields: [examinationId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId, sectionId, academicYearId, examinationId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([status])
}

model Award {
  id           String        @id @default(cuid())
  publicId     String        @unique @default(uuid())
  schoolId     String
  studentId    String
  type         String
  title        String
  description  String?
  awardedDate  DateTime
  approvedBy   String?
  status       String        @default("PENDING")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  school       School        @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  certificates Certificate[]

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
}

model Certificate {
  id                String    @id @default(cuid())
  publicId          String    @unique @default(uuid())
  schoolId          String
  awardId           String
  studentId         String
  certificateNumber String    @unique
  issuedAt          DateTime  @default(now())
  issuedBy          String
  fileUrl           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  award             Award     @relation(fields: [awardId], references: [id])
  school            School    @relation(fields: [schoolId], references: [id])
  student           Student   @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId])
  @@index([certificateNumber])
}

model Homework {
  id             String       @id @default(cuid())
  publicId       String       @unique @default(uuid())
  schoolId       String
  classId        String
  sectionId      String?
  subjectId      String
  teacherId      String
  academicYearId String
  title          String
  description    String?
  dueDate        DateTime
  attachmentUrl  String?
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicYearId])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  publicId       String       @unique @default(uuid())
  schoolId       String
  classId        String
  sectionId      String?
  subjectId      String
  teacherId      String
  academicYearId String
  dayOfWeek      Int
  startTime      DateTime
  endTime        DateTime
  roomNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  school         School       @relation(fields: [schoolId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, classId, sectionId, subjectId, teacherId, academicYearId, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@index([teacherId])
  @@index([academicYearId])
}

model Notification {
  id               String           @id @default(cuid())
  publicId         String           @unique @default(uuid())
  schoolId         String
  senderId         String
  type             String
  title            String
  body             String
  data             String?
  targetRoles      String
  targetUserIds    String
  targetClassIds   String
  targetSectionIds String
  isSchoolWide     Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  school           School           @relation(fields: [schoolId], references: [id])
  sender           User             @relation(fields: [senderId], references: [id])

  @@index([schoolId])
  @@index([senderId])
  @@index([publishedAt])
}

model File {
  id            String    @id @default(cuid())
  publicId      String    @unique @default(uuid())
  schoolId      String
  uploadedById  String
  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  path          String?
  category      String?
  relatedEntity String?
  relatedId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  school        School    @relation(fields: [schoolId], references: [id])
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])

  @@index([schoolId])
  @@index([uploadedById])
  @@index([category])
  @@index([relatedEntity, relatedId])
}

model SchoolSetting {
  id        String   @id @default(cuid())
  schoolId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  schoolId     String?
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  oldValues    String?
  newValues    String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])
  school       School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

model BackupRecord {
  id          String    @id @default(cuid())
  publicId    String    @unique @default(uuid())
  schoolId    String
  type        String
  status      String
  storageUrl  String?
  size        Int?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  initiatedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  school      School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([startedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  category        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@index([token])
  @@index([userId])
}





















